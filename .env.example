# Templat Konfigurasi Deployment (Rujukan Sahaja)
# Projek ini ialah aplikasi statik GitHub Pages + Google Apps Script tanpa bundler.
# Jangan masukkan token peribadi atau rahsia sebenar ke dalam fail yang dicommit.

# URL Web App Google Apps Script (/exec) — ditetapkan dalam src/config/appConfig.js
APPS_SCRIPT_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec

# URL laman GitHub Pages — ditetapkan dalam backend/Code.gs (pemalar SITE)
SITE_URL=https://munirrr19.github.io/tuntutan-kelas/

# Script Properties dalam Google Apps Script (diurus automatik oleh Code.gs):
# FOLDER_JADUAL=<ID_FOLDER_GOOGLE_DRIVE>
